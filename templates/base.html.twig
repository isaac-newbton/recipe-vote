<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Cheesesteak Day 2021!{% endblock %}</title>
        <link rel="preconnect" href="https://fonts.gstatic.com">
        <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,400;0,700;1,400&family=Oswald:wght@400;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/styles/style.css">
        {% block stylesheets %}
        {% endblock %}
        <!-- Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-525LDW2');</script>
        <!-- End Google Tag Manager -->
        {% block javascripts %}
        {% endblock %}
        <meta name="twitter:card" content="summary">
        <meta name="twitter:site" content="@steak_umm">
        <meta name="twitter:title" content="{% block twtitle %}Steak-umm Cheesesteak Day 2021{% endblock %}">
        <meta name="twitter:description" content="This Cheesesteak Day, we're upping the steaks by giving away OVER A YEAR'S WORTH OF BEEF to a few lucky beeflings.">
        <meta name="twitter:image" content="{% block twimg %}https://steakumm.allebach.com/images/header.png{% endblock %}">
    </head>
    <body>
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-525LDW2"
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
        {% block body %}{% endblock %}
    </body>
</html>
